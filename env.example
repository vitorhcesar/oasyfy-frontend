# API
VITE_API_URL=http://localhost:8080
# Optional: separate checkout host. When set and different from the portal origin,
# /c/:publicId on the portal redirects to this base URL.
# On that hostname the PWA service worker is NOT registered (buyer flow).
# VITE_CHECKOUT_URL=https://pay.omegapay.com
# VAPID public key is fetched from GET /api/v1/seller/notifications/vapid-public-key
# (configure VAPID_* on the backend).
